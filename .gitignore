# ---- Python 字节码 / 缓存 ----
__pycache__/
*.py[cod]
*$py.class
*.so

# ---- 虚拟环境 ----
.venv/
venv/
env/
ENV/

# ---- 打包 / 分发 ----
build/
dist/
*.egg-info/
.eggs/
wheels/

# ---- 测试与覆盖率 ----
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ---- 类型检查 / 静态分析缓存 ----
.mypy_cache/
.ruff_cache/
.pytype/

# ---- IDE ----
.vscode/
.idea/
*.iml
*.swp

# ---- 操作系统 ----
Thumbs.db
Desktop.ini
.DS_Store

# ---- Qt / PySide6 运行时产物 ----
*.qmlc
*.jsc
.qmlcache/

# ---- 本项目运行时产物 ----
# output/ 与 data/ 由 app.config.ensure_runtime_dirs() 在启动时创建，
# 内容属于用户数据，不进版本库。
output/
data/
logs/
*.log

# ---- 凭据：翻译 API 的本地密钥一律不入库 ----
.env
*.local.json
# 覆盖 config.local.json 本体及其全部派生物：
# save_config() 写的 .bak / .tmp，以及手动备份（.bak.20260926 之类）
config.local.json*
